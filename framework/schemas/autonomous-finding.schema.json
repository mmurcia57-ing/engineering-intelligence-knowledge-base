{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Autonomous Framework Finding",
  "type": "object",
  "required": [
    "id",
    "type",
    "statement",
    "evidence",
    "currentBoundary",
    "disposition"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "type": {
      "enum": [
        "PRODUCT_GAP",
        "UX_GAP",
        "FUNCTIONAL_GAP",
        "ENGINEERING_GAP",
        "ASSURANCE_GAP",
        "OPERABILITY_GAP",
        "EVOLUTION_OPPORTUNITY",
        "EXTERNAL_DEPENDENCY",
        "SPEC_BLOCKER"
      ]
    },
    "statement": {
      "type": "string"
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "impact": {
      "type": "string"
    },
    "currentBoundary": {
      "type": "boolean"
    },
    "disposition": {
      "enum": [
        "FIX_NOW",
        "HARDEN_NOW",
        "SPECIFY_NEXT",
        "EXPERIMENT",
        "EXTERNAL",
        "REJECT_DEFER"
      ]
    }
  },
  "additionalProperties": false
}
