{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Capability Mission Closure Assessment",
  "type": "object",
  "required": [
    "capabilityId",
    "coreQuestion",
    "observedDepth",
    "requiredDepth",
    "evidence",
    "gaps",
    "disposition"
  ],
  "properties": {
    "capabilityId": {
      "type": "string"
    },
    "coreQuestion": {
      "type": "string"
    },
    "observedDepth": {
      "enum": [
        "ABSENT",
        "REPRESENTED",
        "FUNCTIONAL",
        "END_TO_END",
        "ASSURED",
        "OPERATIONAL"
      ]
    },
    "requiredDepth": {
      "enum": [
        "REPRESENTED",
        "FUNCTIONAL",
        "END_TO_END",
        "ASSURED",
        "OPERATIONAL"
      ]
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "gaps": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "disposition": {
      "enum": [
        "FIX_NOW",
        "HARDEN_NOW",
        "SPECIFY_NEXT",
        "EXPERIMENT",
        "EXTERNAL",
        "REJECT_DEFER"
      ]
    }
  },
  "additionalProperties": false
}
